      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "path": {
          "$ref": "#/$defs/safe_path"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
