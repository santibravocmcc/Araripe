      "const": "https://observatoriodachapadadoararipe.com/data/schemas/phase2a4-derivative-manifest-v1.schema.json"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "package_id": {
      "type": "string",
      "pattern": "^p2a4-derivative-package-v1-[0-9a-f]{64}$"
    },
    "package_type": {
      "const": "phase2a4_provisional_blinded_method_comparison_derivative"
    },
    "scientific_status": {
      "const": "provisional_audit_inputs_only"
    },
    "method_decision_status": {
      "const": "none"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "generation_command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "runtime_versions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "generator_source_inventory": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "local_only": {
      "const": true
    },
    "parent_binding": {
      "$ref": "#/$defs/parent_binding"
    },
    "registry_binding": {
      "$ref": "#/$defs/registry_binding"
    },
    "schema_bindings": {
      "$ref": "#/$defs/schema_bindings"
    },
    "factorial_design": {
      "$ref": "#/$defs/factorial_design"
    },
    "case_population": {
      "$ref": "#/$defs/case_population"
    },
    "source_provenance": {
      "$ref": "#/$defs/source_provenance"
    },
    "review": {
      "$ref": "#/$defs/review"
    },
    "blinding": {
      "$ref": "#/$defs/blinding"
    },
    "decision_state": {
      "$ref": "#/$defs/decision_state"
    },
    "claims": {
      "$ref": "#/$defs/claims"
    },
    "integrity": {
      "$ref": "#/$defs/integrity"
    },
    "generation_limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "artifact_inventory_rule": {
      "type": "string",
      "minLength": 1
    },
    "artifact_inventory": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "checksum_file": {
      "const": "CHECKSUMS.sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "safe_path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_.@/-]+$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/safe_path"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "parent_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase2a3_package_id",
        "population_snapshot_id",
        "phase2a3_manifest_sha256",
