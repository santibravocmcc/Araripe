        },
        "scientific_status": {
          "const": "provisional_audit_inputs_only"
        },
        "parent_artifact_inventory_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "parent_package_mutated": {
          "const": false
        },
        "canonical_observation_or_event_ids_inferred": {
          "const": false
        }
      }
    },
    "registry_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry_id",
        "registry_version",
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "registry_id": {
          "const": "araripe-phase2a4-candidates-v1"
        },
        "registry_version": {
          "const": "1.0.0"
        },
        "path": {
          "const": "config/phase2a4_candidates_v1.json"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "schema_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "path",
        "bytes",
        "sha256"
