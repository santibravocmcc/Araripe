    "parent_binding",
    "registry_binding",
    "schema_bindings",
    "factorial_design",
    "case_population",
    "source_provenance",
    "review",
    "blinding",
    "decision_state",
    "claims",
    "integrity",
    "generation_limitations",
    "artifact_inventory_rule",
