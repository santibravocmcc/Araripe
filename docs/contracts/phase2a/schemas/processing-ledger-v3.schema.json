{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://observatoriodachapadadoararipe.com/data/schemas/processing-ledger-v3.schema.json",
  "title": "Araripe manifest-bound processing ledger v3",
  "description": "One terminal row per expected physical acquisition plus reconciled UTC-date summaries.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ledger_id",
    "identity_inputs_sha256",
    "run_manifest_id",
    "run_manifest_sha256",
    "monitoring_extent_id",
    "algorithm_version",
    "generated_at",
    "order_policy",
    "replay_policy",
    "expected_acquisitions",
    "terminal_rows",
    "daily_summaries",
    "summary",
    "integrity"
  ],
  "properties": {
    "schema_version": { "const": "3.0.0" },
    "ledger_id": { "$ref": "#/$defs/ledger_id" },
    "identity_inputs_sha256": { "$ref": "#/$defs/sha256" },
    "run_manifest_id": { "$ref": "#/$defs/run_manifest_id" },
    "run_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "monitoring_extent_id": { "type": "string", "minLength": 1 },
    "algorithm_version": { "$ref": "#/$defs/semver" },
    "generated_at": { "$ref": "#/$defs/utc_timestamp" },
    "order_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "secondary"],
      "properties": {
        "primary": { "const": "acquisition_timestamp_utc" },
        "secondary": { "const": "acquisition_id" }
      }
    },
    "replay_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duplicate_terminal_row", "conflicting_terminal_row", "late_same_day_acquisition"],
      "properties": {
        "duplicate_terminal_row": { "const": "no_op" },
        "conflicting_terminal_row": { "const": "reject_fail_closed" },
        "late_same_day_acquisition": { "const": "requires_new_chronological_generation" }
      }
    },
    "expected_acquisitions": {
      "type": "array",
      "items": { "$ref": "#/$defs/expected_acquisition" },
      "minItems": 1
    },
    "terminal_rows": {
      "type": "array",
      "items": { "$ref": "#/$defs/terminal_row" },
      "minItems": 1
    },
    "daily_summaries": {
      "type": "array",
      "items": { "$ref": "#/$defs/daily_summary" },
      "minItems": 1
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_acquisition_count",
        "terminal_acquisition_count",
        "utc_date_count",
        "terminal_utc_date_count",
        "status_counts"
      ],
      "properties": {
        "expected_acquisition_count": { "type": "integer", "minimum": 1 },
        "terminal_acquisition_count": { "type": "integer", "minimum": 0 },
        "utc_date_count": { "type": "integer", "minimum": 1 },
        "terminal_utc_date_count": { "type": "integer", "minimum": 0 },
        "status_counts": { "$ref": "#/$defs/status_counts" }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_acquisitions_sha256",
        "terminal_rows_sha256",
        "daily_summaries_sha256",
        "document_sha256",
        "schema_validated",
        "manifest_reconciled",
        "daily_summaries_reconciled"
      ],
      "properties": {
        "expected_acquisitions_sha256": { "$ref": "#/$defs/sha256" },
        "terminal_rows_sha256": { "$ref": "#/$defs/sha256" },
        "daily_summaries_sha256": { "$ref": "#/$defs/sha256" },
        "document_sha256": { "$ref": "#/$defs/sha256" },
        "schema_validated": { "const": true },
        "manifest_reconciled": { "const": true },
        "daily_summaries_reconciled": { "const": true }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "acquisition_id": { "type": "string", "pattern": "^acq-v3-[a-f0-9]{64}$" },
    "observation_id": { "type": "string", "pattern": "^obs-v3-[a-f0-9]{64}$" },
    "run_manifest_id": { "type": "string", "pattern": "^run-v3-[a-f0-9]{64}$" },
    "ledger_id": { "type": "string", "pattern": "^pl-v3-[a-f0-9]{64}$" },
    "utc_timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "terminal_status": {
      "enum": [
        "complete_with_alerts",
        "complete_zero_alerts",
        "rejected_low_coverage",
        "rejected_quality",
        "failed_download",
        "failed_missing_input",
        "failed_processing"
      ]
    },
    "status_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete_with_alerts",
        "complete_zero_alerts",
        "rejected_low_coverage",
        "rejected_quality",
        "failed_download",
        "failed_missing_input",
        "failed_processing"
      ],
      "properties": {
        "complete_with_alerts": { "type": "integer", "minimum": 0 },
        "complete_zero_alerts": { "type": "integer", "minimum": 0 },
        "rejected_low_coverage": { "type": "integer", "minimum": 0 },
        "rejected_quality": { "type": "integer", "minimum": 0 },
        "failed_download": { "type": "integer", "minimum": 0 },
        "failed_missing_input": { "type": "integer", "minimum": 0 },
        "failed_processing": { "type": "integer", "minimum": 0 }
      }
    },
    "expected_acquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "acquisition_id",
        "identity_inputs_sha256",
        "run_manifest_id",
        "run_manifest_sha256",
        "collection_id",
        "platform",
        "datatake_id",
        "acquisition_timestamp_utc",
        "observed_on",
        "scene_ids",
        "monitoring_extent_id",
        "composite_method_id",
        "grid_id"
      ],
      "properties": {
        "schema_version": { "const": "3.0.0" },
        "acquisition_id": { "$ref": "#/$defs/acquisition_id" },
        "identity_inputs_sha256": { "$ref": "#/$defs/sha256" },
        "run_manifest_id": { "$ref": "#/$defs/run_manifest_id" },
        "run_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "collection_id": { "type": "string", "minLength": 1 },
        "platform": { "enum": ["S2A", "S2B", "S2C"] },
        "datatake_id": { "type": "string", "minLength": 1 },
        "acquisition_timestamp_utc": { "$ref": "#/$defs/utc_timestamp" },
        "observed_on": { "type": "string", "format": "date" },
        "scene_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "monitoring_extent_id": { "type": "string", "minLength": 1 },
        "composite_method_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*-v[1-9][0-9]*$" },
        "grid_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*-v[1-9][0-9]*$" }
      }
    },
    "terminal_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_count", "observation_ids", "artifact_sha256"],
      "properties": {
        "observation_count": { "type": "integer", "minimum": 0 },
        "observation_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/observation_id" },
          "uniqueItems": true
        },
        "artifact_sha256": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        }
      }
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "terminal_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acquisition_id",
        "acquisition_timestamp_utc",
        "observed_on",
        "status",
        "terminal_at",
        "output",
        "reason",
        "terminal_record_sha256"
      ],
      "properties": {
        "acquisition_id": { "$ref": "#/$defs/acquisition_id" },
        "acquisition_timestamp_utc": { "$ref": "#/$defs/utc_timestamp" },
        "observed_on": { "type": "string", "format": "date" },
        "status": { "$ref": "#/$defs/terminal_status" },
        "terminal_at": {
          "description": "Terminal evidence instant and lower bound for persistence finalization of this acquisition's UTC date.",
          "$ref": "#/$defs/utc_timestamp"
        },
        "output": { "$ref": "#/$defs/terminal_output" },
        "reason": {
          "oneOf": [{ "$ref": "#/$defs/reason" }, { "type": "null" }]
        },
        "terminal_record_sha256": { "$ref": "#/$defs/sha256" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "complete_with_alerts" } }, "required": ["status"] },
          "then": {
            "properties": {
              "output": {
                "properties": {
                  "observation_count": { "minimum": 1 },
                  "observation_ids": { "minItems": 1 },
                  "artifact_sha256": { "$ref": "#/$defs/sha256" }
                }
              },
              "reason": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "complete_zero_alerts" } }, "required": ["status"] },
          "then": {
            "properties": {
              "output": {
                "properties": {
                  "observation_count": { "const": 0 },
                  "observation_ids": { "maxItems": 0 },
                  "artifact_sha256": { "$ref": "#/$defs/sha256" }
                }
              },
              "reason": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "rejected_low_coverage",
                  "rejected_quality",
                  "failed_download",
                  "failed_missing_input",
                  "failed_processing"
                ]
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "output": {
                "properties": {
                  "observation_count": { "const": 0 },
                  "observation_ids": { "maxItems": 0 }
                }
              },
              "reason": { "$ref": "#/$defs/reason" }
            }
          }
        }
      ]
    },
    "daily_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_on",
        "expected_acquisition_ids",
        "terminal_acquisition_ids",
        "terminal",
        "terminal_rows_sha256",
        "observation_ids",
        "status_counts",
        "persistence_finalization_allowed",
        "daily_summary_sha256"
      ],
      "properties": {
        "observed_on": { "type": "string", "format": "date" },
        "expected_acquisition_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/acquisition_id" },
          "minItems": 1,
          "uniqueItems": true
        },
        "terminal_acquisition_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/acquisition_id" },
          "minItems": 1,
          "uniqueItems": true
        },
        "terminal": { "const": true },
        "terminal_rows_sha256": { "$ref": "#/$defs/sha256" },
        "observation_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/observation_id" },
          "uniqueItems": true
        },
        "status_counts": { "$ref": "#/$defs/status_counts" },
        "persistence_finalization_allowed": { "const": true },
        "daily_summary_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
