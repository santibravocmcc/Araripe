{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://observatoriodachapadadoararipe.com/data/schemas/acquisition-v3.schema.json",
  "title": "Araripe physical acquisition v3",
  "description": "One Sentinel-2 platform/datatake/timestamp scene set, bound to a replay manifest without collapsing same-day datatakes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "acquisition_id",
    "identity_inputs_sha256",
    "run_manifest_id",
    "run_manifest_sha256",
    "collection_id",
    "platform",
    "datatake_id",
    "acquisition_timestamp_utc",
    "observed_on",
    "scene_ids",
    "monitoring_extent_id",
    "composite_method_id",
    "grid_id"
  ],
  "properties": {
    "schema_version": { "const": "3.0.0" },
    "acquisition_id": { "$ref": "#/$defs/acquisition_id" },
    "identity_inputs_sha256": { "$ref": "#/$defs/sha256" },
    "run_manifest_id": { "$ref": "#/$defs/run_manifest_id" },
    "run_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "collection_id": { "type": "string", "minLength": 1 },
    "platform": { "enum": ["S2A", "S2B", "S2C"] },
    "datatake_id": { "type": "string", "minLength": 1 },
    "acquisition_timestamp_utc": { "$ref": "#/$defs/utc_timestamp" },
    "observed_on": { "type": "string", "format": "date" },
    "scene_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "monitoring_extent_id": { "type": "string", "minLength": 1 },
    "composite_method_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*-v[1-9][0-9]*$" },
    "grid_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*-v[1-9][0-9]*$" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "acquisition_id": { "type": "string", "pattern": "^acq-v3-[a-f0-9]{64}$" },
    "run_manifest_id": { "type": "string", "pattern": "^run-v3-[a-f0-9]{64}$" },
    "utc_timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    }
  }
}
