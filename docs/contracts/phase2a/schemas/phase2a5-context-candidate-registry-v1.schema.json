        "pixel_rule": {
          "type": "object",
          "additionalProperties": false,
          "required": ["evaluation_order", "fire_like", "exposed_soil_or_clearing_like", "mixed_or_uncertain", "not_assessed"],
          "properties": {
            "evaluation_order": {"const": ["fire_like", "exposed_soil_or_clearing_like", "mixed_or_uncertain", "not_assessed"]},
            "fire_like": {"const": "finite measurements and dnbr > 0.27 and post_nbr < 0.10"},
            "exposed_soil_or_clearing_like": {"const": "finite measurements and bsi > 0.10 and dnbr > 0.05 and not fire_like"},
            "mixed_or_uncertain": {"const": "finite measurements and dnbr > 0.10 and neither prior class"},
            "not_assessed": {"const": "measurements are not all finite or none of the prior rules applies"}
