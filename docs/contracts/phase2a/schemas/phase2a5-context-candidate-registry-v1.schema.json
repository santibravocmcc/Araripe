        "candidate_ids": {"const": ["dominant-assessed-share-0.60-v1", "plurality-assessed-margin-0.15-v1"]},
        "candidates": {"const": [{"candidate_id": "dominant-assessed-share-0.60-v1", "decision_rule": "emit the unique top median assessed class only when its median share is >= 0.60; otherwise emit mixed_or_uncertain", "minimum_top_share": 0.6, "minimum_margin": null, "selected_or_activated": false}, {"candidate_id": "plurality-assessed-margin-0.15-v1", "decision_rule": "emit the unique top median assessed class only when its margin over the runner-up is >= 0.15; otherwise emit mixed_or_uncertain", "minimum_top_share": null, "minimum_margin": 0.15, "selected_or_activated": false}]},
