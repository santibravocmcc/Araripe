{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://observatoriodachapadadoararipe.com/data/schemas/lineage-v2.schema.json",
  "title": "Araripe split/merge lineage v2",
  "description": "One deterministic continuation, split, or merge edge set between v2 events. Semantic validation additionally requires continuation self-edges and exact child-event identities derived from trigger observations for split/merge.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lineage_id",
    "identity_inputs_sha256",
    "run_manifest_id",
    "run_manifest_sha256",
    "relation",
    "parent_event_ids",
    "child_event_ids",
    "trigger_observation_ids",
    "effective_acquisition_id",
    "effective_timestamp_utc",
    "observed_on",
    "algorithm_version",
    "raw_observations_preserved",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "lineage_id": { "$ref": "#/$defs/lineage_id" },
    "identity_inputs_sha256": { "$ref": "#/$defs/sha256" },
    "run_manifest_id": { "$ref": "#/$defs/run_manifest_id" },
    "run_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "relation": {
      "description": "Continuation has identical parent/child ID arrays. Split children are exactly child_event_id_v2(split, parents, [trigger]) for each trigger. Merge has the single child_event_id_v2(merge, parents, all triggers). These cross-field equalities are enforced by the semantic validator.",
      "enum": ["continuation", "split", "merge"]
    },
    "parent_event_ids": {
      "type": "array",
      "items": { "$ref": "#/$defs/event_id" },
      "minItems": 1,
      "uniqueItems": true
    },
    "child_event_ids": {
      "type": "array",
      "items": { "$ref": "#/$defs/event_id" },
      "minItems": 1,
      "uniqueItems": true
    },
    "trigger_observation_ids": {
      "type": "array",
      "items": { "$ref": "#/$defs/observation_id" },
      "minItems": 1,
      "uniqueItems": true
    },
    "effective_acquisition_id": { "$ref": "#/$defs/acquisition_id" },
    "effective_timestamp_utc": {
      "description": "Must equal the runtime-normalized canonical UTC representation; enforced semantically.",
      "$ref": "#/$defs/utc_timestamp"
    },
    "observed_on": { "type": "string", "format": "date" },
    "algorithm_version": { "$ref": "#/$defs/semver" },
    "raw_observations_preserved": { "const": true },
    "created_at": { "$ref": "#/$defs/utc_timestamp" }
  },
  "allOf": [
    {
      "if": { "properties": { "relation": { "const": "continuation" } }, "required": ["relation"] },
      "then": {
        "properties": {
          "parent_event_ids": { "minItems": 1, "maxItems": 1 },
          "child_event_ids": { "minItems": 1, "maxItems": 1 }
        }
      }
    },
    {
      "if": { "properties": { "relation": { "const": "split" } }, "required": ["relation"] },
      "then": {
        "properties": {
          "parent_event_ids": { "minItems": 1, "maxItems": 1 },
          "child_event_ids": { "minItems": 2 }
        }
      }
    },
    {
      "if": { "properties": { "relation": { "const": "merge" } }, "required": ["relation"] },
      "then": {
        "properties": {
          "parent_event_ids": { "minItems": 2 },
          "child_event_ids": { "minItems": 1, "maxItems": 1 }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "acquisition_id": { "type": "string", "pattern": "^acq-v2-[a-f0-9]{64}$" },
    "observation_id": { "type": "string", "pattern": "^obs-v2-[a-f0-9]{64}$" },
    "event_id": { "type": "string", "pattern": "^evt-v2-[a-f0-9]{64}$" },
    "lineage_id": { "type": "string", "pattern": "^lin-v2-[a-f0-9]{64}$" },
    "run_manifest_id": { "type": "string", "pattern": "^run-v2-[a-f0-9]{64}$" },
    "utc_timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    }
  }
}
