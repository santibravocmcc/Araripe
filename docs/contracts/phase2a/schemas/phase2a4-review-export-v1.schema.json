{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://observatoriodachapadadoararipe.com/data/schemas/phase2a4-review-export-v1.schema.json",
  "title": "Araripe Phase 2A.4 isolated review export v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "package_phase",
    "package_binding",
    "reviewer_slot",
    "reveal_state",
    "reviews"
  ],
  "properties": {
    "$schema": {
      "const": "https://observatoriodachapadadoararipe.com/data/schemas/phase2a4-review-export-v1.schema.json"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "package_phase": {
      "const": "phase2a4"
    },
    "package_binding": {
      "$ref": "#/$defs/package_binding"
    },
    "reviewer_slot": {
      "enum": ["reviewer-a", "reviewer-b"]
    },
    "reveal_state": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/reveal_record"
      }
    },
    "reviews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "package_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_id",
        "assignment_sha256",
        "review_template_sha256",
        "method_evidence_index_sha256",
        "review_schema_sha256"
      ],
      "properties": {
        "package_id": {
          "type": "string",
          "pattern": "^p2a4-derivative-package-v1-[0-9a-f]{64}$"
        },
        "assignment_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "review_template_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "method_evidence_index_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "review_schema_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "primary_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change_assessment",
        "temporal_assessment",
        "land_cover_assessment"
      ],
      "properties": {
        "change_assessment": {
          "type": "object"
        },
        "temporal_assessment": {
          "type": "object"
        },
        "land_cover_assessment": {
          "type": "object"
        }
      }
    },
    "reveal_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blind_case_id", "revealed", "locked_primary"],
      "properties": {
        "blind_case_id": {
          "type": "string",
          "pattern": "^p2a3-blind-v1-[0-9a-f]{24}$"
        },
        "revealed": {
          "type": "boolean"
        },
        "locked_primary": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/primary_snapshot"}
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"revealed": {"const": true}},
            "required": ["revealed"]
          },
          "then": {
            "properties": {
              "locked_primary": {"$ref": "#/$defs/primary_snapshot"}
            }
          },
          "else": {
            "properties": {
              "locked_primary": {"type": "null"}
            }
          }
        }
      ]
    }
  }
}
