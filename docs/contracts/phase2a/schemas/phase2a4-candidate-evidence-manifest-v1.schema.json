{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://observatoriodachapadadoararipe.com/data/schemas/phase2a4-candidate-evidence-manifest-v1.schema.json",
  "title": "Araripe Phase 2A.4 candidate evidence manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "artifact_type",
    "evidence_id",
    "pipeline_version",
    "generated_at",
    "catalog_accessed_at",
    "runtime_versions",
    "generator_source_inventory",
    "schema_bindings",
    "phase2a3",
    "candidate_registry",
    "rainfall_reference",
    "baseline",
    "cases",
    "counts",
    "claims",
    "artifact_inventory_rule",
    "artifact_inventory",
    "checksum_file"
  ],
  "properties": {
    "$schema": {
      "const": "https://observatoriodachapadadoararipe.com/data/schemas/phase2a4-candidate-evidence-manifest-v1.schema.json"
    },
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "phase2a4_candidate_evidence"},
    "evidence_id": {
      "type": "string",
      "pattern": "^p2a4-candidate-evidence-v1-[0-9a-f]{64}$"
    },
    "pipeline_version": {"const": "phase2a4-candidate-evidence-v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "catalog_accessed_at": {"type": "string", "format": "date-time"},
    "runtime_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python",
        "numpy",
        "pillow",
        "pyproj",
        "pystac",
        "pystac-client",
        "rasterio",
        "gdal",
        "scipy",
        "shapely",
        "jsonschema"
      ],
      "properties": {
        "python": {"type": "string", "minLength": 1},
        "numpy": {"type": "string", "minLength": 1},
        "pillow": {"type": "string", "minLength": 1},
        "pyproj": {"type": "string", "minLength": 1},
        "pystac": {"type": "string", "minLength": 1},
        "pystac-client": {"type": "string", "minLength": 1},
        "rasterio": {"type": "string", "minLength": 1},
        "gdal": {"type": "string", "minLength": 1},
        "scipy": {"type": "string", "minLength": 1},
        "shapely": {"type": "string", "minLength": 1},
        "jsonschema": {"type": "string", "minLength": 1}
      }
    },
    "generator_source_inventory": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "schema_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "case"],
      "properties": {
        "manifest": {"$ref": "#/$defs/artifact"},
        "case": {"$ref": "#/$defs/artifact"}
      }
    },
    "phase2a3": {"type": "object"},
    "candidate_registry": {"type": "object"},
    "rainfall_reference": {"type": "object"},
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_id",
        "baseline_version",
        "manifest_sha256",
        "manifest_artifact",
        "public_base_url",
        "read_mode",
        "rebuild_performed"
      ],
      "properties": {
        "baseline_id": {"type": "string", "minLength": 1},
        "baseline_version": {"const": "1.0.0"},
        "manifest_sha256": {
          "const": "15a1ed3cea7c804d18d2c82c86a7b9a030687fedb01b315d543965b1f26f0a82"
        },
        "manifest_artifact": {"$ref": "#/$defs/artifact"},
        "public_base_url": {"type": "string", "format": "uri", "pattern": "^https://[^?#]+$"},
        "read_mode": {"const": "public_read_only_remote_cog_range_reads"},
        "rebuild_performed": {"const": false}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 60,
      "maxItems": 60,
      "items": {"$ref": "#/$defs/case_summary"}
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_count", "available", "partial", "unavailable"],
      "properties": {
        "case_count": {"const": 60},
        "available": {"type": "integer", "minimum": 0, "maximum": 60},
        "partial": {"type": "integer", "minimum": 0, "maximum": 60},
        "unavailable": {"type": "integer", "minimum": 0, "maximum": 60}
      }
    },
    "claims": {
      "const": {
        "local_only": true,
        "qualified_human_labels_present": false,
        "scientific_accuracy_claim": false,
        "method_selected_or_activated": false,
        "baseline_rebuilt": false,
        "legacy_timeseries_used_or_mutated": false,
        "case_replacement_performed": false,
        "canonical_identity_inferred": false,
        "phase2a5_policy_modified": false
      }
    },
    "artifact_inventory_rule": {
      "const": "all files except manifest.json and CHECKSUMS.sha256"
    },
    "artifact_inventory": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "checksum_file": {"const": "CHECKSUMS.sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "case_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_id", "blind_case_id", "target_date", "status", "record"],
      "properties": {
        "sample_id": {"type": "string", "pattern": "^p2a3-sample-v1-[0-9a-f]{64}$"},
        "blind_case_id": {"type": "string", "pattern": "^p2a3-blind-v1-[0-9a-f]{24}$"},
        "target_date": {"type": "string", "format": "date"},
        "status": {"enum": ["available", "partial", "unavailable"]},
        "record": {"$ref": "#/$defs/artifact"}
      }
    }
  }
}
