{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://observatoriodachapadadoararipe.com/data/schemas/monitoring-extent-v1.schema.json",
  "title": "Araripe Monitoring Extent v1",
  "description": "Versioned geometry for the APA-and-surroundings monitoring footprint.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "extent_id",
    "extent_version",
    "name",
    "status",
    "scope",
    "geometry_crs",
    "geometry",
    "bounds_wgs84",
    "area",
    "source_geometry",
    "canonical_geometry_sha256",
    "canonical_bounds_sha256",
    "canonicalization",
    "change_control"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "extent_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*-v[1-9][0-9]*$"
    },
    "extent_version": {
      "$ref": "#/$defs/semver"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "retired"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "includes_apa_and_surroundings",
        "narrowed_to_apa"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "includes_apa_and_surroundings": {
          "const": true
        },
        "narrowed_to_apa": {
          "const": false
        }
      }
    },
    "geometry_crs": {
      "const": "EPSG:4326"
    },
    "geometry": {
      "$ref": "#/$defs/polygon"
    },
    "bounds_wgs84": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "area": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value_ha",
        "method",
        "crs"
      ],
      "properties": {
        "value_ha": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "method": {
          "const": "planar"
        },
        "crs": {
          "const": "EPSG:32724"
        }
      }
    },
    "source_geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "role"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "role": {
          "const": "bounds_source_only"
        }
      }
    },
    "canonical_geometry_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "canonical_bounds_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "canonicalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "json",
        "axis_order",
        "ring_orientation",
        "ring_start"
      ],
      "properties": {
        "json": {
          "const": "RFC8785"
        },
        "axis_order": {
          "const": "longitude_latitude"
        },
        "ring_orientation": {
          "const": "exterior_ccw_holes_cw"
        },
        "ring_start": {
          "const": "lexicographically_smallest_coordinate"
        }
      }
    },
    "change_control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "geometry_change_requires_new_extent_id",
        "geometry_change_requires_historical_generation",
        "silent_change_forbidden"
      ],
      "properties": {
        "geometry_change_requires_new_extent_id": {
          "const": true
        },
        "geometry_change_requires_historical_generation": {
          "const": true
        },
        "silent_change_forbidden": {
          "const": true
        }
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "position": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "ring": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/position"
      },
      "minItems": 4
    },
    "polygon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "coordinates"
      ],
      "properties": {
        "type": {
          "const": "Polygon"
        },
        "coordinates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ring"
          },
          "minItems": 1
        }
      }
    }
  }
}
